{
  "name": "shortvideoeditor-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"python app.py\" \"npm --prefix web run dev:next\"",
    "dev:backend": "python app.py",
    "dev:frontend": "npm --prefix web run dev:next",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
