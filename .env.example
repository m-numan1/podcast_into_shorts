# Copy to .env and fill in what you need.  .env is gitignored -- never commit it.
#
# Everything here has a working default. With no .env at all the pipeline runs
# in offline heuristic mode: no API keys, no network calls beyond fetching the
# media itself.

# ---------------------------------------------------------------- scoring
# openai | gemini | heuristic
#
# "heuristic" scores clips from measured signals only (pauses, cue density,
# boundary cleanliness). It is a real, declared mode -- output is stamped
# scoring_mode="heuristic" -- not a silent fallback. It is a weak proxy for
# editorial judgement; set a real provider for meaningful rankings.
DEFAULT_LLM_PROVIDER=heuristic

OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SEC=60
LLM_MAX_CONCURRENCY=6
# Caches model responses on disk so re-runs are free.
LLM_CACHE_ENABLED=true

# ------------------------------------------------------------- embeddings
# lexical | openai | gemini
#
# "lexical" is a deterministic offline hashing vectoriser. It measures lexical
# overlap, not meaning, and is used only for near-duplicate detection --
# semantic boundary detection is switched off for it because measurement showed
# it does not separate topics. Use openai/gemini for semantic segmentation.
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM is derived from the model; do not set it.

# ----------------------------------------------------------- transcription
# A faster-whisper model: tiny | base | small | medium | large-v3, each also
# available as an English-only .en variant that is smaller and more accurate
# on English. Bigger is slower. Weights download on first use and are cached
# in ~/.cache/huggingface.
#   tiny.en ~75 MB   base.en ~145 MB   small.en ~480 MB   medium.en ~1.5 GB
WHISPER_MODEL=medium.en
# Force a language (e.g. en) or leave blank to auto-detect.
TRANSCRIPT_LANGUAGE=

# ------------------------------------------------------------ segmentation
SEGMENT_MIN_DURATION_SEC=8
# Hard ceiling. Guarantees an episode can never collapse into one unusable chunk.
SEGMENT_MAX_DURATION_SEC=120

# --------------------------------------------------------------- clipping
MIN_CLIP_DURATION_SEC=30
MAX_CLIP_DURATION_SEC=90
OPTIMAL_CLIP_DURATION_SEC=45
TARGET_CLIP_COUNT_MIN=2
TARGET_CLIP_COUNT_MAX=15
DYNAMIC_CLIP_SCALING=true
# Set to 0.0 for dynamic self-calibration relative to video's top score (or set an explicit floor)
MIN_CLIP_QUALITY_SCORE=0.0
# Two clips are duplicates above this intersection-over-shorter ratio.
DEDUP_OVERLAP_THRESHOLD=0.5
# Cap on candidates sent for evaluation. Each one costs 6 LLM calls.
CANDIDATE_SHORTLIST_SIZE=40

# --------------------------------------------------------------- rendering
RENDER_ENABLED=false
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
# blur_pad keeps the whole frame against a blurred fill; crop can cut faces.
RENDER_MODE=blur_pad
RENDER_CRF=20
RENDER_PRESET=medium
RENDER_BURN_CAPTIONS=true
# Highlight the currently-spoken word inside its caption cue. false = static cues.
RENDER_CAPTION_HIGHLIGHT=true
# Subtitle style preset: hormozi | capcut_neon | mrbeast | single_word | minimal
SUBTITLE_PRESET=hormozi
RENDER_MAX_CLIPS=5
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --------------------------------------------------------------------- web
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ------------------------------------------------------------------- misc
ENV=development
LOG_LEVEL=INFO
# Makes an interrupted run resumable with the same --thread-id.
CHECKPOINT_ENABLED=true
