# Environment Configuration for AI Video Editor
# Copy this file to .env and fill in your API keys

# LLM Provider: "openai", "gemini", or "mock" (default: mock for offline mode)
DEFAULT_LLM_PROVIDER=mock

# OpenAI (if using openai provider)
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o

# Google Gemini (if using gemini provider)
GEMINI_API_KEY=

# Environment
ENV=development
